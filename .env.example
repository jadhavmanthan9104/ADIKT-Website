# ==============================================================================
# MASTER ENVIRONMENT CONFIGURATION (.env.example)
# Production-Ready Self-Hosted D2C Fashion Ecommerce Platform (Medusa v2 + Next.js)
# ==============================================================================
# NOTE: Copy this file to .env in your backend and storefront directories,
# and replace placeholder values with actual production credentials.
# NEVER commit .env files containing real secrets to version control!
# ==============================================================================

# ==============================================================================
# 1. GENERAL & ENVIRONMENT SETTINGS
# ==============================================================================
NODE_ENV=development
PORT=9000
BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:9000/app

# Brand Information
BRAND_NAME="ADIKT Clothing Co."
SUPPORT_EMAIL="support@adiktclothing.com"
DEFAULT_CURRENCY="INR"
DEFAULT_COUNTRY="IN"

# ==============================================================================
# 2. DATABASE & REDIS INFRASTRUCTURE (PostgreSQL is Single Source of Truth)
# ==============================================================================
# PostgreSQL Connection URL (Used by Medusa v2 core & custom DML modules)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/adikt_commerce
DATABASE_DRIVER_OPTIONS='{"ssl": false}'

# Connection Pooling (Recommended for high traffic D2C drops)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000

# Redis Cache & Event Bus Connection
# Format: redis://[user]:[password]@[host]:[port]
REDIS_URL=redis://localhost:6379

# ==============================================================================
# 3. SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
# Generate secure 64-char random strings: `openssl rand -hex 32`
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_12345
COOKIE_SECRET=super_secret_cookie_signing_key_must_be_random_and_secure_67890

# Medusa v2 Publishable API Key (Created in Medusa Admin -> Settings -> Publishable API Keys)
# Used by the Storefront to access store APIs with scoped permissions
MEDUSA_PUBLISHABLE_KEY=pk_test_01HYZSAMPLEKEYFORSTOREFRONT987654321

# Medusa v2 Secret API Key (Server-to-Server communication only, NEVER expose to client)
MEDUSA_SECRET_API_KEY=sk_test_01HYZSAMPLESECRETKEYFORSERVERCOMMUNICATION

# CORS Allowed Origins (Comma-separated in production)
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000,https://adiktclothing.com,https://www.adiktclothing.com
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://admin.adiktclothing.com
AUTH_CORS=http://localhost:3000,http://localhost:9000,https://adiktclothing.com

# ==============================================================================
# 4. PAYMENT GATEWAY: RAZORPAY & CASH ON DELIVERY (COD)
# ==============================================================================
# Razorpay API Credentials (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere123456
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere789012
RAZORPAY_ACCOUNT_NAME="ADIKT Clothing"

# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Webhooks -> Add New Webhook)
# URL: https://api.adiktclothing.com/api/webhooks/razorpay
# Subscribed Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_YourWebhookSecretKeyHere98765

# COD Configuration
COD_ENABLED=true
COD_FEE_INR=0
COD_MAX_ORDER_AMOUNT=10000
COD_OTP_VERIFICATION_REQUIRED=false

# ==============================================================================
# 5. SHIPPING & LOGISTICS: SHIPROCKET
# ==============================================================================
# Shiprocket API Credentials (From Shiprocket Dashboard -> Settings -> API -> Configure)
SHIPROCKET_API_EMAIL="logistics@adiktclothing.com"
SHIPROCKET_API_PASSWORD="YourShiprocketSecurePassword"
SHIPROCKET_AUTO_GENERATE_AWB=true
SHIPROCKET_DEFAULT_PICKUP_LOCATION="Primary Warehouse Mumbai"
SHIPROCKET_WEBHOOK_TOKEN="custom_secure_token_for_shiprocket_tracking_webhook"

# Default Garment Parcel Dimensions (cm) and Weight (kg) for rate estimation
DEFAULT_PARCEL_LENGTH=30
DEFAULT_PARCEL_BREADTH=25
DEFAULT_PARCEL_HEIGHT=5
DEFAULT_PARCEL_WEIGHT=0.5

# ==============================================================================
# 6. OBJECT STORAGE & MEDIA (S3 / Cloudinary)
# ==============================================================================
# Provider selection: "s3" or "cloudinary" or "local"
MEDIA_PROVIDER=s3

# S3 / MinIO / Cloudflare R2 / AWS S3 Configuration
S3_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=adikt-fashion-media
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_CDN_URL=https://media.adiktclothing.com

# Cloudinary Alternative (if MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=adikt-fashion
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# ==============================================================================
# 7. TRANSACTIONAL EMAILS & NOTIFICATIONS (Resend / SendGrid)
# ==============================================================================
# Email Provider: "resend" or "sendgrid" or "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
EMAIL_FROM="ADIKT Orders <orders@adiktclothing.com>"
EMAIL_REPLY_TO="support@adiktclothing.com"

# Admin alert recipient for system events / low stock
ADMIN_ALERT_EMAIL="ops@adiktclothing.com"

# ==============================================================================
# 8. ANALYTICS & EVENT TRACKING
# ==============================================================================
# Google Analytics 4 (GA4) Measurement ID for Storefront
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol API Secret (For server-side fallback event tracking)
GA4_API_SECRET=your_ga4_measurement_protocol_api_secret

# Meta Pixel (Optional for D2C retargeting)
NEXT_PUBLIC_META_PIXEL_ID=

# ==============================================================================
# 9. CUSTOMER STOREFRONT NEXT.JS PUBLIC ENVIRONMENT VARIABLES
# ==============================================================================
# Public URLs & API Endpoints accessible to the browser client
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_01HYZSAMPLEKEYFORSTOREFRONT987654321
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION="in"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere123456
NEXT_PUBLIC_BRAND_NAME="ADIKT"
NEXT_PUBLIC_SITE_TITLE="ADIKT | Modern D2C Fashion & Luxury Streetwear"
NEXT_PUBLIC_SITE_DESCRIPTION="Discover premium oversized tees, heavyweight hoodies, tailored cargos, and contemporary streetwear designed in India."
